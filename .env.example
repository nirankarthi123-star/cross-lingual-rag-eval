# ==============================================================================
# Cross-Lingual Faithfulness Evaluation of RAG Chatbots on Code-Mixed Queries
# Environment Configuration Template
# ==============================================================================

# Application Configuration
APP_NAME="Cross-Lingual Faithfulness Evaluation of RAG Chatbots"
APP_ENV=development
DEBUG=true
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# Future Model & Provider API Key Placeholders (NEVER commit real keys)
OPENAI_API_KEY=your_openai_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
HUGGINGFACE_API_KEY=your_huggingface_api_key_here

# Default Providers & Models Configuration
DEFAULT_LLM_PROVIDER=gemini
DEFAULT_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Database Configuration (For Phase 4+ SQLite persistence)
DATABASE_URL=sqlite:///./data/rag_eval.db

# Document Ingestion & Chunking Parameters
DOCUMENTS_DIR=data/documents
PROCESSED_DIR=data/processed
DEFAULT_CHUNK_SIZE=500
DEFAULT_CHUNK_OVERLAP=100

# Embeddings & Vector Store Configuration
EMBEDDING_MODEL=intfloat/multilingual-e5-base
EMBEDDING_DIMENSION=768
VECTOR_STORE_DIR=data/vector_store
DEFAULT_TOP_K=5

# LLM Provider Configuration
LLM_PROVIDER=groq
GROQ_API_KEY=your-groq-api-key-here
LLM_MODEL=openai/gpt-oss-20b
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=1024
RAG_TOP_K=5

# Experimental Mitigation
MITIGATION_ENABLED=false

# Faithfulness Judge Configuration
JUDGE_LLM_MODEL=openai/gpt-oss-20b
JUDGE_TEMPERATURE=0.0
HALLUCINATION_THRESHOLD=0.8
JUDGE_PROMPT_VERSION=v1
